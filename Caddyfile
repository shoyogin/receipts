# Plain HTTP is fine on VPN-only access. For HTTPS with an internal CA later:
#
# dataset-browser.internal {
#     tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
#     # …same handlers as below…
# }
#
# Reviewers are configured in caddy.env, not here. See caddy.env.example.

:80 {
    log {
        output stdout
    }

    request_body {
        max_size 2MB
    }

    # Reviewers live in caddy.env, which is untracked — no name and no hash is
    # ever committed, and pulling this file cannot overwrite anyone's password.
    # Each slot holds one "<username> <bcrypt hash>" pair; empty ones are
    # ignored, so unused slots cost nothing. Add more lines here for a sixth
    # reviewer — that is a config change, not a secret.
    basic_auth {
        {$REVIEWER_1}
        {$REVIEWER_2}
        {$REVIEWER_3}
        {$REVIEWER_4}
        {$REVIEWER_5}
    }

    reverse_proxy browser:8800 {
        # Identity from basic_auth; header_up replaces whatever the client sent.
        header_up X-Remote-User {http.auth.user.id}

        # Dataset zips are streamed chunk by chunk as they are read off disk.
        # Buffering them here would stall the download until the whole version
        # had been built in Caddy's memory.
        flush_interval -1
    }
}
