# Reviewer logins. Copy to caddy.env on each host — caddy.env is untracked, so
# nothing here is ever committed and `git pull` can never overwrite it.
#
# One slot per reviewer: REVIEWER_<n>=<username> <bcrypt hash>
# Empty slots are ignored. The Caddyfile has five; add more lines there if you
# need them.
#
# The username is what lands in X-Remote-User, so it becomes the name on every
# verdict, comment and correction — and it is what the four-eyes rule compares,
# so you need at least two reviewers for anyone to accept a fix.
#
# Generate a hash (paste it exactly as printed, $ signs and all):
#   docker run --rm caddy:2 caddy hash-password --plaintext 'THE_PASSWORD'

REVIEWER_1=alice $2a$14$replace.this.with.a.real.hash.from.the.command.above
REVIEWER_2=bob $2a$14$replace.this.with.a.real.hash.from.the.command.above
REVIEWER_3=
REVIEWER_4=
REVIEWER_5=
